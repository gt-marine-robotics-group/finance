# MRG Purchasing - Environment Variables
# Copy this to .env and fill in values

# Flask secret key (generate a random string for production)
SECRET_KEY=change-me-to-something-random

# Shared login password
LOGIN_PASSWORD=boats0519

# rclone remote path to the xlsx file on SharePoint
RCLONE_REMOTE=onedrive:Documents - Marine Robotics Group/OPS-1 Operations/FY27 Finances/FY27_Bills_Budget.xlsx

# Local path where the xlsx is stored after rclone sync
LOCAL_XLSX_PATH=/root/mrg-finance/FY27_Bills_Budget.xlsx

# Sheet name in the xlsx
XLSX_SHEET_NAME=Bills

# rclone config content (base64 or raw) - paste your rclone.conf content here
# This gets written to /root/.config/rclone/rclone.conf on container start
RCLONE_CONFIG_CONTENT=

# Port (Railway sets this automatically)
PORT=5000
